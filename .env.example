# API key de Google Gemini para el asistente del sitio.
# Local: copia este archivo a .env.local y pon la clave real.
# Vercel: Project Settings -> Environment Variables.
GEMINI_API_KEY=

# Modelo a usar. Si se deja vacío, el servidor usa gemini-2.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash-lite

# El límite de peticiones NO vive en el repo: se configura como regla de Vercel Firewall.
# Los valores aplicados están documentados en docs/TECNICO.md.
#
# VERCEL_ENV, VERCEL_URL y VERCEL_BRANCH_URL las define Vercel automáticamente.
# No hay que declararlas: el handler las usa para permitir el origen en despliegues de prueba.
