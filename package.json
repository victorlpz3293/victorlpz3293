{
  "name": "victorlpz3293",
  "version": "1.0.0",
  "description": "Perfil profesional de Victor R. Lopez: web, CV y README generados desde data/profile.json",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "check-claims": "node scripts/check-claims.mjs",
    "build:context": "node scripts/build-context.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/estilo.css -o public/css/estilo.css --minify",
    "build:site": "node scripts/build-site.mjs",
    "build:pdf": "node scripts/build-pdf.mjs",
    "build:readme": "node scripts/build-readme.mjs",
    "assets": "node scripts/optimize-assets.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "preview": "node scripts/capture-preview.mjs",
    "build": "npm run validate && npm run build:context && npm run build:css && npm run build:site && npm run check-claims"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "subset-font": "^2.9.0",
    "tailwindcss": "^3.4.19"
  }
}
